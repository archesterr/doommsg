# Public hostname. Caddy obtains a Let's Encrypt certificate for it.
DOOMMSG_DOMAIN=chat.example.com
# Public IPv4 of the host, advertised by coturn.
TURN_EXTERNAL_IP=203.0.113.10
# Shared secret between the relay and coturn: at least 32 characters, only
# letters, digits and + / = _ . - (both refuse to start otherwise):
#   openssl rand -base64 48
DOOMMSG_TURN_SECRET=
# Optional: require an invitation code to register (keeps the server private).
DOOMMSG_REGISTRATION_CODE=

# Optional: point builds at internal mirrors.
# GO_IMAGE=registry.internal/library/golang:1.26-alpine
# RUNTIME_IMAGE=registry.internal/distroless/static-debian12:nonroot
# NODE_IMAGE=registry.internal/library/node:22-alpine
# CADDY_IMAGE=registry.internal/library/caddy:2-alpine
# COTURN_IMAGE=registry.internal/coturn/coturn:4.6-alpine
# GOPROXY=https://goproxy.internal,direct
# NPM_REGISTRY=https://npm.internal/
# REGISTRY_PREFIX=registry.internal/doommsg/
# TAG=latest
